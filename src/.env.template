# .env — City Hall Server — edit ALL values before starting

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bioko_app
DB_PASSWORD=CHANGE_TO_STRONG_PASSWORD
DB_NAME=bus_tracking_gq

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=CHANGE_TO_64_RANDOM_CHARACTERS

# ── Security — ALL Pi buses must use this same key ────────────────────────────
API_KEY=BIOKO_BUS_KEY_CHANGE_ME

# ── Engine alerts — mechanic's phone with country code ────────────────────────
MECHANIC_PHONE=+2406XXXXXXX

# ── SMS (Africa's Talking — optional, needed only for SMS to passengers) ──────
AT_USERNAME=
AT_API_KEY=
AT_SENDER=BIOKO

# ── WhatsApp (Evolution API — optional) ──────────────────────────────────────
WA_BASE_URL=http://localhost:8080
WA_API_KEY=
WA_INSTANCE=bioko

# ── Intranet backbone IP (set by install_city_hall.sh) ───────────────────────
BACKBONE_IP=10.10.0.1

# ── ETA engine ────────────────────────────────────────────────────────────────
ETA_MIN_SAMPLES=30
ETA_HISTORY_DAYS=45
POSITION_STALE_SECONDS=120
